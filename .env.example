# ── HR Interview Simulator — Environment Variables ────────────────────────────
# Copy this file to .env and fill in your values.

# OpenAI API Key (optional — app runs in mock mode without it)
OPENAI_API_KEY=your-openai-api-key-here

# LLM Model (default: gpt-3.5-turbo)
LLM_MODEL=gpt-3.5-turbo

# Embedding Model
EMBEDDING_MODEL=text-embedding-ada-002

# Database URL (default: SQLite local file)
DATABASE_URL=sqlite:///./hr_simulator.db

# FAISS Index Path
FAISS_INDEX_PATH=data/faiss_index

# Interview Settings
DEFAULT_ANSWER_TIME_LIMIT=120
MAX_QUESTIONS_PER_SESSION=10

# Debug Mode
DEBUG=True
